{
  "name": "camond-centre",
  "version": "1.0.0",
  "description": "Command center desktop overlay with zen aesthetics",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:5173 && npm run electron:build && electron .",
    "build": "tsc && vite build && npm run electron:build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "clean": "rm -rf dist .vite electron/dist node_modules",
    "clean:install": "npm run clean && npm install",
    "rebuild": "npm run clean:install && npm run build"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "framer-motion": "^11.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.camond.centre",
    "productName": "Camond Centre",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    }
  }
}
